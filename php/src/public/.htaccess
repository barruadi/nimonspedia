Options -Indexes

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# [ API ]
RewriteRule ^api(?:/|$) index.php [QSA,L]

# [ SPA ]
RewriteRule ^(home|profile|login|register|seller)(?:/|$) index.html [QSA,L]

# [ Server Render ]
RewriteRule ^ index.php [QSA,L]